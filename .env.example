# Base de datos (Neon)
# DIRECT_URL es el endpoint SIN -pooler. La app lo usa en runtime porque el
# adapter de Prisma ya tiene pool propio: el pooler de Neon traba las
# transacciones ($transaction).
DIRECT_URL="postgresql://user:password@ep-xxx.sa-east-1.aws.neon.tech/grancentral?sslmode=verify-full&channel_binding=require"
# DATABASE_URL con -pooler queda de respaldo; las migraciones leen DIRECT_URL
# desde prisma.config.ts.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.sa-east-1.aws.neon.tech/grancentral?sslmode=verify-full&channel_binding=require"

# Auth.js
# Generar con: npx auth secret
AUTH_SECRET=""
# Dejar vacía en desarrollo: Auth.js deduce la URL del request. Definirla solo
# en producción, con el dominio real.
AUTH_URL=""
# Hace falta si corrés `next start` en local sin AUTH_URL. En Vercel no molesta.
AUTH_TRUST_HOST="true"

# Mercado Pago
# Credenciales de prueba: https://www.mercadopago.com.ar/developers/panel/app
# Access Token (App e-commerce, Checkout Pro). El webhook secret sale de
# Webhooks > Configurar notificaciones, después de guardar la URL.
MP_ACCESS_TOKEN=""
NEXT_PUBLIC_MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""

# Cloudinary (imágenes de productos)
# Se sacan del Dashboard de cloudinary.com. El cloud name va duplicado porque
# el navegador lo necesita para armar la URL de subida.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# URL pública del sitio, usada en los callbacks de pago y en el sitemap
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Opcional. Solo las usa `npm run db:seed` en una base vacía.
# El seed no pisa la contraseña si el admin ya existe.
# SEED_ADMIN_EMAIL="admin@grancentral.com.ar"
# SEED_ADMIN_PASSWORD="DemoAdmin2026!"
